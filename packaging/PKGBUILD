pkgname=es-exia
pkgver=3.5.0
pkgrel=1
pkgdesc="ES-DE (EmulationStation Desktop Edition) derivative - es-exia"
arch=('x86_64')
url="https://gitlab.com/es-de/emulationstation-de"
license=('MIT')
depends=('bluez-libs' 'curl' 'ffmpeg' 'freeimage' 'freetype2' 'gettext' 'harfbuzz' 'icu' 'libgit2' 'poppler' 'pugixml' 'sdl2')
makedepends=('cmake' 'bluez-libs' 'curl' 'pkgconf' 'make' 'ffmpeg' 'freeimage' 'freetype2' 'gettext' 'harfbuzz' 'icu' 'libgit2' 'poppler' 'pugixml' 'sdl2')
provides=('emulationstation-de')
conflicts=('emulationstation-de')

source=("es-exia-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  export CXXFLAGS=""
  export MAKEFLAGS="-j4"
  cmake -DAUR_BUILD=on -B build -S "$srcdir/emulationstation-exia"
  make -C build -j4
}

package() {
  make -C build DESTDIR="$pkgdir" install
}

# devdoc/54: the system definitions live in a user-owned sqlite store. After an
# install/upgrade the bundled builtin store may have new systems, so run the
# user-side sync hook (backup + sync + check) when it is available.
_systems_sync_hook() {
  local user="${SUDO_USER:-emu}"
  local hook="/home/$user/tools/systems/install-hook.sh"
  if [ -x "$hook" ] && [ -f "/home/$user/.config/ES-DE/custom_systems/es_systems_user.sqlite" ]; then
    echo "==> 同步 es_systems 用户库 (devdoc/54)"
    sudo -u "$user" "$hook" || echo "警告: systems sync 失败，请手动执行 $hook"
  fi
}

post_install() {
  _systems_sync_hook
}

post_upgrade() {
  _systems_sync_hook
}
